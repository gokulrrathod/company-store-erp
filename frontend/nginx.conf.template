server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Railway assigns the backend a new internal address on every redeploy. A
    # bare hostname in proxy_pass is resolved once at nginx startup and cached
    # forever, so a redeploy leaves this container proxying to a dead IP until
    # nginx itself restarts. Using a variable forces re-resolution per the
    # resolver's TTL instead.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;

    location /api/ {
        # proxy_pass with a variable disables nginx's normal location-prefix
        # rewriting, so no URI suffix is given here — the original request
        # URI (already /api/...) is forwarded unchanged.
        set $backend_upstream ${NGINX_BACKEND_HOST};
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
